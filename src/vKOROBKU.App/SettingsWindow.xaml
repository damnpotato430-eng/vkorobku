<Window x:Class="vKOROBKU.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:vKOROBKU.App.Resources"
        Title="{x:Static res:Strings.Settings_Title}" Width="600" Height="700"
        MinWidth="520" MinHeight="420" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <!-- The settings used to live in a fixed 880px-tall window, which barely fit a
         1080p screen and could not fit at all once the interface scale grew. The
         content scrolls instead, so the window stays comfortably smaller than any
         supported screen. -->
    <Grid x:Name="RootGrid" Margin="28,24,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,10,0">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Settings_Title}" FontSize="25" FontWeight="Bold" />
                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                           Text="{x:Static res:Strings.Settings_Subtitle}" />

                <TextBlock Text="{x:Static res:Strings.Settings_LanguageSection}" Margin="0,20,0,0" FontSize="10"
                           FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                <ComboBox x:Name="LanguageBox" Margin="0,7,0,0" Height="36" Padding="8,4"
                          Style="{StaticResource DarkComboBox}" VerticalContentAlignment="Center" />
                <TextBlock Text="{x:Static res:Strings.Settings_LanguageRestartHint}" Margin="0,6,0,0" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" />

                <TextBlock Text="{x:Static res:Strings.Settings_ScaleSection}" Margin="0,18,0,0" FontSize="10"
                           FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                <ComboBox x:Name="ScaleBox" Margin="0,7,0,0" Height="36" Padding="8,4"
                          Style="{StaticResource DarkComboBox}" VerticalContentAlignment="Center" />
                <TextBlock Text="{x:Static res:Strings.Settings_ScaleHint}" Margin="0,6,0,0" FontSize="11"
                           TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />

                <CheckBox Grid.Row="4" x:Name="WatcherEnabledBox" Margin="0,18,0,0"
                          Content="{x:Static res:Strings.Settings_WatcherEnabled}"
                          Foreground="{StaticResource TextBrush}" FontSize="13" />

                <TextBlock Text="{x:Static res:Strings.Settings_DecayThreshold}" Margin="0,18,0,0" FontSize="10"
                           FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                <TextBox x:Name="DecayBox" Margin="0,7,0,0" Height="36" Padding="10,7"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="#353A44" CaretBrush="{StaticResource AccentBrush}" />

                <TextBlock Text="{x:Static res:Strings.Settings_MinimumSavings}" Margin="0,14,0,0" FontSize="10"
                           FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                <TextBox x:Name="SavingsBox" Margin="0,7,0,0" Height="36" Padding="10,7"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="#353A44" CaretBrush="{StaticResource AccentBrush}" />

                <TextBlock Text="{x:Static res:Strings.Settings_HiddenSection}" Margin="0,18,0,0" FontSize="10"
                           FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HiddenCountText" VerticalAlignment="Center" FontSize="13" />
                    <Button x:Name="RestoreHiddenButton" Grid.Column="2" Content="{x:Static res:Strings.Settings_RestoreHidden}"
                            Click="RestoreHiddenClick" Padding="12,7" Style="{StaticResource SecondaryButton}"
                            ToolTip="{x:Static res:Strings.Settings_RestoreHiddenTooltip}" />
                </Grid>

                <TextBlock Text="{x:Static res:Strings.Settings_SkipSection}" Margin="0,20,0,0" FontSize="10"
                           FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                <CheckBox x:Name="SkipEnabledBox" Margin="0,9,0,0" Foreground="{StaticResource TextBrush}" FontSize="13"
                          Content="{x:Static res:Strings.Settings_SkipEnabled}" />
                <TextBlock x:Name="DefaultListText" Margin="0,7,0,0" TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewExtensionBox" Height="34" Padding="10,6"
                             Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="#353A44" CaretBrush="{StaticResource AccentBrush}"
                             ToolTip="{x:Static res:Strings.Settings_ExtensionExample}" />
                    <Button Grid.Column="2" Content="{x:Static res:Strings.Settings_AddExtension}" Click="AddExtensionClick" Padding="14,7"
                            Style="{StaticResource SecondaryButton}" />
                </Grid>
                <ListBox x:Name="UserExtensionsList" Margin="0,8,0,0" Height="96"
                         Background="{StaticResource SurfaceBrush}" BorderBrush="#353A44" BorderThickness="1" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="{x:Static res:Strings.Settings_RemoveSelected}" Click="RemoveExtensionClick" Padding="12,7"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Grid.Column="3" Content="{x:Static res:Strings.Settings_ResetList}" Click="ResetExtensionsClick" Padding="12,7"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="{x:Static res:Strings.Settings_ResetListTooltip}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="{x:Static res:Strings.Settings_Save}" Click="SaveClick" />
            <Button Grid.Column="2" Content="{x:Static res:Strings.Settings_Cancel}" Click="CancelClick" Style="{StaticResource SecondaryButton}" />
        </Grid>
    </Grid>
</Window>
