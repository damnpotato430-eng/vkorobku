<Window x:Class="vKOROBKU.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:vKOROBKU.App.Resources"
        xmlns:controls="clr-namespace:vKOROBKU.App.Controls"
        Title="vKOROBKU" Icon="Assets/vkorobku.ico" FontSize="14"
        Width="1480" Height="900" MinWidth="1040" MinHeight="700"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="Disclosure" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          HorizontalContentAlignment="Stretch" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBorder" Background="Transparent" Padding="4,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Arrow" Text="›" FontSize="22" Foreground="{StaticResource MutedTextBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" />
                                                <ContentPresenter Grid.Column="1" Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                  VerticalAlignment="Center" TextElement.Foreground="{StaticResource TextBrush}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#20242C" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" ContentSource="Content" Margin="4,4,4,12" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="CardStatus" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CompressionState}" Value="Compressed"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding CompressionState}" Value="PartiallyCompressed"><Setter Property="Foreground" Value="#FFBD55" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.RowSpan="3" Background="#111318" BorderBrush="#252932" BorderThickness="0,0,1,0" Padding="18,28,18,20">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="vKOROBKU" FontSize="25" FontWeight="Black" Foreground="{StaticResource AccentBrush}" Margin="4,0,0,0" />
                    <TextBlock Text="{x:Static res:Strings.Sidebar_Tagline}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,4,0,30" />
                    <Border Background="#222D1B" CornerRadius="8" Padding="16,14"><TextBlock Text="{x:Static res:Strings.Nav_Library}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" /></Border>
                    <Button Content="{x:Static res:Strings.Nav_Operations}" Command="{Binding ShowOperationsCommand}" Style="{StaticResource NavButton}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="{x:Static res:Strings.Nav_Settings}" Command="{Binding ShowSettingsCommand}" Style="{StaticResource NavButton}" />
                    <Button Content="{x:Static res:Strings.Nav_About}" Command="{Binding ShowAboutCommand}" Style="{StaticResource NavButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24,28,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.6*" MinWidth="300" />
                <ColumnDefinition>
                    <ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="24" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedGame}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition>
                    <ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="*" /><Setter Property="MinWidth" Value="320" /><Setter Property="MaxWidth" Value="440" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedGame}" Value="False"><Setter Property="Width" Value="0" /><Setter Property="MinWidth" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Header_Title}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LibraryCountText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="{x:Static res:Strings.Header_AddFolder}" Command="{Binding AddFolderCommand}" Style="{StaticResource SecondaryButton}" Padding="14,11" FontSize="13" />
                        <Button Content="⋯" FontSize="20" Margin="8,0,0,0" Padding="12,5" Style="{StaticResource SecondaryButton}"
                                Click="OpenMoreMenu" ToolTip="{x:Static res:Strings.UI_More}" AutomationProperties.Name="{x:Static res:Strings.UI_More}">
                            <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{Binding ScanButtonText}" Command="{Binding RefreshLibraryCommand}" />
                                <MenuItem Header="{x:Static res:Strings.Header_RefreshCovers}" Command="{Binding RefreshCoversCommand}" />
                                <MenuItem Header="{x:Static res:Strings.Watcher_CheckNow}" Command="{Binding CheckWatchedGamesCommand}" />
                            </ContextMenu></Button.ContextMenu>
                        </Button>
                    </WrapPanel>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="#292D35" BorderThickness="1" CornerRadius="8" Padding="12,0" Margin="0,0,0,10">
                    <Expander x:Name="DrivesExpander" Style="{StaticResource Disclosure}">
                        <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.UI_Drives}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalSavingsText}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" TextWrapping="Wrap" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" />
                        </Grid></Expander.Header>
                        <StackPanel>
                            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Computer.Drives}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Background="#111318" CornerRadius="5" Padding="10,8" Margin="0,0,0,6">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayText}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding SavingsText}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{Binding AllTimeStatsText}" ToolTip="{Binding AllTimeStatsTooltip}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" />
                            <Button Content="{x:Static res:Strings.Watcher_CheckNow}" Command="{Binding CheckWatchedGamesCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </Expander>
                </Border>
                <Border Grid.Row="2" Background="#282215" BorderBrush="#55401C" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                        Visibility="{Binding WatcherHasFindings, Converter={StaticResource BoolVisibility}}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding WatcherSummaryText}" Foreground="#FFBD55" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <ToggleButton Grid.Column="1" Content="{x:Static res:Strings.UI_View}" IsChecked="{Binding ShowOnlyDegraded}" Style="{StaticResource ExpertToggle}" Margin="12,0,0,0" ToolTip="{x:Static res:Strings.DegradedFilter_Tooltip}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="SearchBox" Height="40" Padding="12,0" VerticalContentAlignment="Center" FontSize="13"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="#353A44" CaretBrush="{StaticResource AccentBrush}" />
                            <TextBlock Text="{x:Static res:Strings.Search_Placeholder}" IsHitTestVisible="False" Margin="13,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="13">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ToggleButton Grid.Column="1" Content="{Binding MultiSelectToggleText}" IsChecked="{Binding IsMultiSelectMode, Mode=OneWay}" Command="{Binding ToggleMultiSelectCommand}" Style="{StaticResource ExpertToggle}" Margin="8,0" ToolTip="{x:Static res:Strings.MultiSelect_Tooltip}" />
                        <ComboBox Grid.Column="2" Width="145" Height="40" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" Style="{StaticResource DarkComboBox}" ToolTip="{x:Static res:Strings.Sort_Tooltip}" />
                    </Grid>
                    <Border Padding="12" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Margin="0,10,0,0" Visibility="{Binding MultiSelectVisibility}">
                        <StackPanel>
                            <TextBlock Text="{Binding QueueSelectionText}" FontSize="12" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="{x:Static res:Strings.Queue_SelectAllCompressed}" Command="{Binding SelectAllCompressedCommand}" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,0,8,8" />
                                <ComboBox Width="160" Height="32" ItemsSource="{Binding QueueMethodOptions}" SelectedItem="{Binding SelectedQueueMethod}" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8" ToolTip="{x:Static res:Strings.Queue_MethodTooltip}" />
                                <Button Content="{x:Static res:Strings.Queue_Start}" Command="{Binding StartQueueCommand}" Padding="10,7" Margin="0,0,8,8" />
                                <Button Content="{x:Static res:Strings.Queue_StartDecompress}" Command="{Binding StartDecompressQueueCommand}" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Button Content="{x:Static res:Strings.Watcher_RecompressAll}" Command="{Binding RecompressDegradedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding ShowOnlyDegraded, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
                <Grid Grid.Row="4">
                    <ListBox x:Name="GameList" ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}" Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingTilePanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="Width" Value="272" /><Setter Property="Margin" Value="0,0,14,14" /><Setter Property="Padding" Value="0" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnGameItemPreviewMouseRightButtonDown" />
                            <Setter Property="ContextMenu"><Setter.Value><ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{x:Static res:Strings.Card_OpenFolder}" Command="{Binding OpenGameFolderCommand}" />
                                <MenuItem Header="{x:Static res:Strings.Card_AddToQueue}" Command="{Binding AddToQueueCommand}" />
                                <MenuItem Header="{x:Static res:Strings.Card_RefreshCover}" Command="{Binding RefreshSelectedCoverCommand}" />
                                <MenuItem Header="{x:Static res:Strings.Card_RecheckState}" Command="{Binding RecheckCompressionCommand}" />
                                <MenuItem Header="{x:Static res:Strings.Card_RemoveFromLibrary}" Command="{Binding RemoveGameCommand}" />
                            </ContextMenu></Setter.Value></Setter>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" Background="{StaticResource SurfaceBrush}" CornerRadius="9" BorderBrush="Transparent" BorderThickness="1.5" Padding="10"><ContentPresenter /></Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource SurfaceHoverBrush}" /></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel>
                                <Border Height="140" Background="#101217" CornerRadius="6" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding SourceText}" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                                        <Image Source="{Binding CoverPath, Converter={StaticResource LocalImageConverter}}" Stretch="UniformToFill" />
                                        <Border Background="#DD171A20" Padding="6" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Visibility="{Binding DataContext.MultiSelectVisibility, RelativeSource={RelativeSource AncestorType=ListBox}}"><CheckBox IsChecked="{Binding IsQueueSelected}" AutomationProperties.Name="{Binding Name}" /></Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DiskSizeText}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding InstallPath}" />
                                    <Border Grid.Column="1" Background="#222730" CornerRadius="5" Padding="7,4"><TextBlock Text="{Binding CompactStatusText}" Style="{StaticResource CardStatus}" ToolTip="{Binding CompressionStatusText}" /></Border>
                                </Grid>
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="20">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=GameList}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="{x:Static res:Strings.UI_NoResults}" FontSize="18" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{x:Static res:Strings.Welcome_EmptyLibrary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" Visibility="{Binding EmptyLibraryVisibility}" />
                    </StackPanel>
                </Grid>
                <Expander Grid.Row="5" Header="{Binding QueueTitle}" Style="{StaticResource Disclosure}" Visibility="{Binding QueuePanelVisibility}" IsExpanded="{Binding IsQueueRunning, Mode=OneWay}" Margin="0,8,0,0">
                    <StackPanel>
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">                                <ItemsControl ItemsSource="{Binding QueueItems}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Margin="8,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                    <Setter Property="Foreground" Value="#7FB2FF" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="#FF7A7A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                    <Setter Property="Foreground" Value="#FFB84D" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl></ScrollViewer>
                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding QueueControlsVisibility}">
                            <Button Content="{x:Static res:Strings.Queue_Skip}" Command="{Binding SkipQueueItemCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,8,8" />
                            <Button Content="{x:Static res:Strings.Queue_StopAfterCurrent}" Command="{Binding StopQueueAfterCurrentCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,8,8" />
                            <Button Content="{x:Static res:Strings.Queue_StopAll}" Command="{Binding StopQueueCommand}" Style="{StaticResource StopButton}" Padding="10,6" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="#292D35" BorderThickness="1" CornerRadius="10"
                    Visibility="{Binding HasSelectedGame, Converter={StaticResource BoolVisibility}}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="#292D35" BorderThickness="0,1,0,0" Padding="20,14" Visibility="{Binding PrimaryActionVisibility}">
                        <Button Content="{Binding PrimaryGameActionText}" Command="{Binding PrimaryGameCommand}" Style="{StaticResource PrimaryActionButton}" />
                    </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                    <StackPanel>
                        <Button Content="×" Command="{Binding ClearGameSelectionCommand}" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="18" HorizontalAlignment="Right" Margin="0,0,0,8" ToolTip="{x:Static res:Strings.MultiSelect_Cancel}" />
                        <Border Height="180" Background="#101217" CornerRadius="8" ClipToBounds="True">
                            <Grid><TextBlock Text="{Binding SelectedGame.SourceText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /><Image Source="{Binding SelectedGame.CoverPath, Converter={StaticResource LocalImageConverter}}" Stretch="UniformToFill" /></Grid>
                        </Border>
                        <TextBlock Text="{Binding SelectedGame.Name}" FontSize="24" FontWeight="Bold" Margin="0,18,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedGame.SourceText}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                        <Border BorderBrush="#30353F" BorderThickness="0,1,0,1" Padding="0,18" Margin="0,18,0,0">
                            <StackPanel><TextBlock Text="{x:Static res:Strings.UI_DiskSize}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                <TextBlock Text="{Binding SelectedGame.DiskSizeText}" FontSize="30" FontWeight="Bold" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding SelectedGame.CompactStatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.UI_AnalysisHint}" Visibility="{Binding AnalysisIntroVisibility}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,18,0,0" FontSize="14" LineHeight="22" />
                        <Border Background="#1B2333" Padding="12" CornerRadius="6" Margin="0,14,0,0" Visibility="{Binding DirectStorageWarningVisibility}"><TextBlock Text="{x:Static res:Strings.Panel_DirectStorageWarning}" TextWrapping="Wrap" Foreground="#A8C6FF" FontSize="12" /></Border>
                        <StackPanel Margin="0,18,0,0" Visibility="{Binding PredictionVisibility}">
                            <TextBlock Text="{x:Static res:Strings.Estimate_SavingsLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedEstimate.SavingsText}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding SelectedEstimate.PerformanceText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                        <Expander Header="{x:Static res:Strings.UI_Advanced}" Style="{StaticResource Disclosure}" Margin="0,14,0,0">
                            <StackPanel>
                                <ToggleButton Content="{x:Static res:Strings.Panel_ExpertMode}" IsChecked="{Binding IsExpertMode}" Style="{StaticResource ExpertToggle}" HorizontalAlignment="Left" />
                                <StackPanel Visibility="{Binding ExpertOptimizationVisibility}" Margin="0,12,0,0">
                                    <TextBlock Text="{x:Static res:Strings.Panel_AnalysisAccuracy}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding AnalysisModes}" SelectedItem="{Binding SelectedAnalysisMode}" DisplayMemberPath="DisplayText" Height="36" Style="{StaticResource DarkComboBox}" />
                                </StackPanel>
                                                        <ListBox Margin="0,12,0,0" ItemsSource="{Binding Estimates}"
                                 SelectedItem="{Binding SelectedEstimate}" Background="Transparent" BorderThickness="0"
                                 Visibility="{Binding EstimateListVisibility}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ModeCard" Background="#111318" BorderBrush="#292D35"
                                                        BorderThickness="1" CornerRadius="8" Padding="11">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ModeCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="ModeCard" Property="Background" Value="#1B2518" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding AlgorithmText}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding EstimatedSizeText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource AccentBrush}">
                                            <Run Text="{x:Static res:Strings.Estimate_SavingsLabel}" /><Run Text="{Binding SavingsText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding PerformanceText}" Margin="0,4,0,0" FontSize="10"
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                        <Grid Margin="0,3,0,0">
                                            <TextBlock Text="{Binding RatioText}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource MutedTextBrush}">
                                                <Run Text="{x:Static res:Strings.Estimate_ConfidenceLabel}" /><Run Text="{Binding ConfidenceText, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                                <Button Content="{Binding AnalysisButtonText}" Command="{Binding AnalyzeCommand}" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" Visibility="{Binding UncompressedPanelVisibility}" />
                                <TextBlock Text="{Binding AnalysisSummary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" Visibility="{Binding UncompressedPanelVisibility}" />
                                <TextBlock Text="{Binding SelectedGame.CompressionInfoText}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" Visibility="{Binding CompressedPanelVisibility}" />
                                <Button Content="{x:Static res:Strings.Action_Decompress}" Command="{Binding DecompressCommand}" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" Visibility="{Binding PartiallyCompressedVisibility}" />
                                <Button Content="{x:Static res:Strings.Card_RecheckState}" Command="{Binding RecheckCompressionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" />
                                <Button Content="{x:Static res:Strings.Panel_ReviewIdentity}" Command="{Binding ReviewIdentityCommand}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Visibility="{Binding IdentityReviewVisibility}" />
                                <Button Content="{x:Static res:Strings.Card_RemoveFromLibrary}" Command="{Binding RemoveGameCommand}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Expander>
                        <Button Content="{x:Static res:Strings.Card_OpenFolder}" Command="{Binding OpenGameFolderCommand}" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" Padding="12,12" />
                        <TextBlock Text="{x:Static res:Strings.Info_AutoConfirm}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,8" Visibility="{Binding UncompressedPanelVisibility}" />
                    </StackPanel>
                </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="24,12,24,0" Visibility="{Binding BusyVisibility}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="{Binding ActiveOperationText}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Visibility="{Binding ActiveCompressionInfoVisibility}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="{Binding ActiveCompressionModeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ActiveCompressionDetailsText, Mode=OneWay}" /></TextBlock>
                    <ProgressBar Value="{Binding OperationProgress, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" Margin="0,8,0,0" Background="#292D35" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
                    <TextBlock Text="{Binding OperationSummary}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StopButton}">
                        <Setter Property="Content" Value="{x:Static res:Strings.Action_Stop}" /><Setter Property="Command" Value="{Binding CancelCurrentCommand}" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsQueueRunning}" Value="True"><Setter Property="Content" Value="{x:Static res:Strings.Queue_StopAll}" /><Setter Property="Command" Value="{Binding StopQueueCommand}" /></DataTrigger></Style.Triggers>
                    </Style></Button.Style>
                </Button>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Grid.Row="2" Margin="24,12,24,16">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
        </Grid>
    </Grid>
</Window>
